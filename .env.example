# ==============================================================================
# Environment Configuration — SpamHam AI Platform
# Author: Abhishek Bisht <abhiishekbishtt@gmail.com>
# =============================================================================

# Server Port
PORT=8080

# MongoDB Configuration (Atlas or Local)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGO_DATABASE_NAME="spamham_db"
MONGO_COLLECTION_NAME="spam_ham"

# Optional AWS S3 Configuration (for remote model storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
MODEL_BUCKET_NAME="spamham-models"
